{
  "name": "MPNW Crew Hub",
  "short_name": "MPNW Crew",
  "description": "Schedule, job info and products for the MP Northwest crew.",
  "scope": "./",
  "display": "standalone",
  "background_color": "#0e1210",
  "theme_color": "#0e1210",
  "icons": [
    {
      "src": "icon-pc-16.png",
      "sizes": "16x16",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icon-pc-32.png",
      "sizes": "32x32",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icon-pc-48.png",
      "sizes": "48x48",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icon-pc-64.png",
      "sizes": "64x64",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icon-pc-96.png",
      "sizes": "96x96",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icon-pc-128.png",
      "sizes": "128x128",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icon-pc-256.png",
      "sizes": "256x256",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icon-pc-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    }
  ],
  "display_override": [
    "window-controls-overlay",
    "standalone"
  ],
  "shortcuts": [
    {
      "name": "This week",
      "url": "./?go=week",
      "icons": [
        {
          "src": "sc-week.png",
          "sizes": "96x96",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Calendar",
      "url": "./?go=cal",
      "icons": [
        {
          "src": "sc-cal.png",
          "sizes": "96x96",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "New job",
      "url": "./?go=newjob",
      "icons": [
        {
          "src": "sc-newjob.png",
          "sizes": "96x96",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Add a receipt",
      "url": "./?go=receipt",
      "icons": [
        {
          "src": "sc-receipt.png",
          "sizes": "96x96",
          "type": "image/png"
        }
      ]
    }
  ]
}
